# Supabase (from Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key — server only (never expose to the browser); required for invites
SUPABASE_SECRET_KEY=sb_secret_...

# Optional: mailto recipient when participants email a copy of results
NEXT_PUBLIC_RESULTS_EMAIL=sahra@parc.do
